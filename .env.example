# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas,
# then Database > Connect > Drivers, and paste the connection string here -
# put your real username/password in it and add a database name before the ?)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xposters?retryWrites=true&w=majority

# Any long random string - used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (free tier) - from cloudinary.com dashboard after signup
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Creates the first admin login on server startup (only runs once - if an
# admin already exists in the database, these are ignored)
ADMIN_EMAIL=admin@xposters.test
ADMIN_PASSWORD=change-this-password

# Your deployed frontend's URL (Vercel), so the backend's CORS allows it.
# Leave as-is for local dev against `npm run dev` on the frontend.
CLIENT_URL=http://localhost:5173

PORT=4000

# Order notifications (email, via Gmail) - all optional. Leave any of these
# unset and email sending is skipped quietly (orders still work fine).
#
# EMAIL_USER - the Gmail address to send from
# EMAIL_APP_PASSWORD - a 16-character Gmail "App Password" (not your normal
#   Gmail password). Generate one at myaccount.google.com/apppasswords -
#   requires 2-Step Verification to be turned on for that Google account first.
# OWNER_EMAIL - where new-order alerts go (can be the same as EMAIL_USER,
#   or a different inbox you check)
EMAIL_USER=
EMAIL_APP_PASSWORD=
OWNER_EMAIL=

# WhatsApp order notifications (Twilio) - not currently used by the code
# (switched to email above). Left here in case you revisit WhatsApp later.
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN - from your Twilio Console home page
#   (console.twilio.com)
# TWILIO_WHATSAPP_FROM - your Twilio WhatsApp sender, in the form
#   "whatsapp:+14155238886"
# OWNER_WHATSAPP_NUMBER - your own phone number, as a plain 10-digit number
#   with no country code, e.g. 9876543210
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_NUMBER=